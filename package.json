{
  "name": "petrinetjs",
  "version": "0.5.0",
  "description": "Petri net modeler for the browser, based on diagram-js: drawing, PNML, simulation, state space, invariants, siphons and traps.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "Hamied Nabizada",
  "contributors": [
    "Maximilian König (ptn-js, the original)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsu-aut/PetriNet.js.git"
  },
  "homepage": "https://github.com/hsu-aut/PetriNet.js#readme",
  "bugs": {
    "url": "https://github.com/hsu-aut/PetriNet.js/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "net.js",
    "src",
    "assets",
    "LICENSE",
    "README.md",
    "!src/**/*.test.js",
    "!src/net/fixtures.js"
  ],
  "keywords": [
    "diagram-js",
    "invariants",
    "modeler",
    "petri-net",
    "pnml",
    "reachability-graph",
    "simulation"
  ],
  "scripts": {
    "test": "node --test src/net/ src/reachability/ src/layout/ src/findings/ src/properties/ src/search/",
    "test:browser": "node test/browser/run.mjs",
    "pretest:browser": "playwright install chromium",
    "demo": "node demo/serve.mjs"
  },
  "dependencies": {
    "bpmn-font": "^0.12.1",
    "diagram-js": "^15.26.0",
    "diagram-js-direct-editing": "^3.5.1",
    "ids": "^1.0.5",
    "inherits": "^2.0.4",
    "min-dash": "^4.2.3",
    "min-dom": "^5.3.0",
    "moddle": "^7.2.0",
    "moddle-xml": "^11.0.0",
    "object-refs": "^0.4.0",
    "tiny-svg": "^4.1.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.63.0"
  }
}
