    title: "openbpt-modeler-petri-net (ptn-js)"
    authors:
      - family-names: König
        given-names: Maximilian
      - name: "Business Process Technology, Hasso Plattner Institute"
    license: MIT
    repository-code: "https://github.com/bptlab/openbpt-modeler-petri-net"
    notes: "The modeler this software is a fork of."
